# CS AI Bridge API env.

# Redis (AI config + tenant schema).
CS_AI_BRIDGE_REDIS_URL=redis://redis:6379/0
CS_AI_BRIDGE_AI_CONFIG_KEY_PREFIX=cs_ai_bridge:ai:config
CS_AI_BRIDGE_ASSISTANTS_CONFIG_KEY_PREFIX=cs_ai_bridge:config:assistants
CS_AI_BRIDGE_SCHEMA_KEY_PREFIX=cs_ai_bridge:schema

# OpenAI / Gemini.
CS_AI_BRIDGE_LLM_PROVIDER=openai
CS_AI_BRIDGE_LLM_API_KEY=
OPENAI_API_KEY=
CS_AI_BRIDGE_OPENAI_MODEL=gpt-4o-mini
CS_AI_BRIDGE_LLM_BASE_URL=https://api.openai.com/v1
CS_AI_BRIDGE_GEMINI_API_KEY=
CS_AI_BRIDGE_GEMINI_MODEL=gemini-2.0-flash

# Runtime.
CS_AI_BRIDGE_LOG_LEVEL=INFO
CS_AI_BRIDGE_LLM_TIMEOUT=120
CS_AI_BRIDGE_API_PORT=8080

# MCP server (internal; not exposed to OpenAI).
CS_AI_BRIDGE_MCP_URL=http://cs-ai-bridge-mcp:8000/mcp
CS_AI_BRIDGE_MCP_TIMEOUT=30

# Gateway orchestrator (default when request includes tenant).
CS_AI_BRIDGE_MCP_ORCHESTRATOR=true
CS_AI_BRIDGE_MCP_ORCHESTRATOR_MAX_ROUNDS=8
CS_AI_BRIDGE_VALIDATE_MCP_TOOLS=true
CS_AI_BRIDGE_OPENAI_MCP_TOOLS=mcp_query,mcp_create,mcp_write,ai_query
