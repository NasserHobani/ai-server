# CS AI Bridge API env.

# Redis AI config; optional because env fallback is supported.
# Docker hitting host Redis on Docker Desktop: redis://host.docker.internal:6379/0
CS_AI_BRIDGE_REDIS_URL=redis://host.docker.internal:6379/0
CS_AI_BRIDGE_AI_CONFIG_KEY_PREFIX=cs_ai_bridge:ai:config

# Env fallback used when Redis is unavailable or the provider key is missing.
CS_AI_BRIDGE_LLM_PROVIDER=openai
CS_AI_BRIDGE_LLM_MODEL=

# OpenAI-compatible provider.
CS_AI_BRIDGE_LLM_API_KEY=
OPENAI_API_KEY=
CS_AI_BRIDGE_OPENAI_MODEL=gpt-4o-mini
CS_AI_BRIDGE_LLM_BASE_URL=https://api.openai.com/v1

# Gemini provider.
CS_AI_BRIDGE_GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
CS_AI_BRIDGE_GEMINI_MODEL=gemini-2.0-flash
CS_AI_BRIDGE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# API runtime.
CS_AI_BRIDGE_LLM_TIMEOUT=120
CS_AI_BRIDGE_API_PORT=8080
